# Copia este archivo a .env y completa con los valores de tu app web de Firebase
# (Firebase Console -> Configuracion del proyecto -> Tus apps -> app Web -> "Config").
# Estos valores no son secretos: identifican el proyecto, no dan acceso privilegiado.

VITE_FIREBASE_API_KEY=TU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto

# URL del backend (NestJS).
VITE_API_URL=http://localhost:3000
