rules_version = '2';

// Toda la app pasa por el backend (NestJS), que usa el Admin SDK y por lo
// tanto ignora estas reglas. Ningun cliente (navegador) habla con Firestore
// directamente, asi que aqui se niega todo el acceso como defensa en
// profundidad por si alguna vez se agrega el SDK de cliente por error.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
