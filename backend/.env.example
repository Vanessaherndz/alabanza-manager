# Copia este archivo a .env y completa con los valores de tu proyecto Firebase.
# Se obtienen en Firebase Console -> Configuracion del proyecto -> Cuentas de servicio
# -> "Generar nueva clave privada" (descarga un JSON).

FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pega la private_key del JSON tal cual, entre comillas y con \n como saltos de linea.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Dominio sintetico para el login por usuario (igual que en el frontend).
USERNAME_DOMAIN=alabanza-manager.com

# Origen permitido para CORS (URL del frontend).
FRONTEND_ORIGIN=http://localhost:5173

PORT=3000

# Usados solo por `npm run seed:admin` para crear el primer administrador del sistema.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_FULL_NAME=Administrador
